# Text-to-speech for the clip editor (/api/tts)
# "voicestudio" (local voice cloning, default) or "zai" (cloud)
TTS_PROVIDER=voicestudio

# Local VoiceStudio backend (https://github.com/debpalash/VoiceStudio)
VOICESTUDIO_URL=http://localhost:3900
# Name or ID of a voice saved in VoiceStudio (Voice -> Clone)
VOICESTUDIO_VOICE=Demo Voice
# Engine: omnivoice (CC-BY-NC, non-commercial) or cosyvoice (Apache-2.0)
VOICESTUDIO_MODEL=omnivoice
VOICESTUDIO_LANGUAGE=en
